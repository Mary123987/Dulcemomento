PORT=4173
HOST=127.0.0.1
# Required for server-side admin authentication.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Use a valid address; passwords must be at least 8 characters.
ADMIN_EMAIL=
# Generate a unique random value of at least 32 characters.
SESSION_SECRET=
ADMIN_DATA_FILE=data/admin-data.json

# Add a key only on the backend host. Never place it in frontend code.
RESEND_API_KEY=
# Explicit server-side switch. Keep false until external delivery is intentionally enabled.
EXTERNAL_EMAIL_ENABLED=false
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Dulce Momento
RESEND_REPLY_TO=

# For same-origin local use, leave FRONTEND_ORIGIN empty.
# For GitHub Pages plus a separately hosted HTTPS backend, set the exact site origin.
FRONTEND_ORIGIN=
PUBLIC_API_URL=http://127.0.0.1:4173
